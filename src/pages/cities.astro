---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSubpage from '../components/HeroSubpage.astro';
import BrandLogos from '../components/BrandLogos.astro';
import CTAAvatars from '../components/CTAAvatars.astro';
import CoveragePinMap from '../components/CoveragePinMap.astro';

const title = 'Window Film Service Areas | Salt Lake City Metro | Utah';
const description = 'Window Film Salt Lake City serves Salt Lake City, Ogden, Provo, and Sandy. Leading residential and commercial window film in Utah.';

const cities = [
  {
    label: 'Salt Lake City',
    state: 'PA',
    desc: 'Our home base and primary service area. We serve residential and commercial properties across all neighborhoods — from Downtown Salt Lake City high-rises and Sugar House rowhouses to South Salt Lake retail and Millcreek homes.',
    img: '/images/wfp-cities-salt-lake-city.jpg',
    alt: 'Window film Salt Lake City Utah',
    href: '/cities/salt-lake-city/',
  },
  {
    label: 'Sandy',
    state: 'NJ',
    desc: 'Serving residential and commercial properties throughout Sandy County — including West Valley City, Murray, Midvale, Bountiful, Taylorsville, and surrounding Salt Lake Valley communities.',
    img: '/images/wfp-cities-sandy.jpg',
    alt: 'Window film Sandy Utah',
    href: '/cities/sandy/',
  },
  {
    label: 'Reading',
    state: 'PA',
    desc: 'Professional window film installation for Weber County homes, office parks, and commercial buildings throughout the greater Ogden metro area — including South Ogden and North Ogden.',
    img: '/images/wfp-cities-reading.jpg',
    alt: 'Window film Reading Utah',
    href: '/cities/ogden/',
  },
  {
    label: 'Provo',
    state: 'PA',
    desc: 'Serving Salt Lake County residential and commercial properties in Provo, Orem, Springville, and neighboring Utah County communities.',
    img: '/images/wfp-cities-provo.jpg',
    alt: 'Window film Provo Utah',
    href: '/cities/provo/',
  },
];

const alsoServing = [
  { label: 'West Valley City, UT',    href: '/contact/' },
  { label: 'Murray, UT',       href: '/contact/' },
  { label: 'Bountiful, UT',    href: '/contact/' },
  { label: 'Midvale, UT',   href: '/contact/' },
  { label: 'Taylorsville, UT',     href: '/contact/' },
  { label: 'Lehi, UT',        href: '/contact/' },
  { label: 'Orem, UT',    href: '/contact/' },
  { label: 'Layton, UT',     href: '/contact/' },
  { label: 'Draper, UT',        href: '/contact/' },
  { label: 'West Jordan, UT',     href: '/contact/' },
];
---

<BaseLayout title={title} description={description} canonical="https://windowfilmsaltlakecity.com/cities/">

<HeroSubpage
  eyebrow="Service Areas"
  title="Cities We Serve"
  subtitle="Professional window film across the Salt Lake City metropolitan area and the Wasatch Front."
  bg="/images/wfp-cities-hero.jpg"
  cta1={{ label: 'Get a Free Quote', href: '/contact/' }}
  cta2={{ label: 'See Our Services', href: '/services/' }}
/>

<div class="ip-page-body">

<!-- ══════════════════════════════════════
     INTRO — 2-col: big heading left, text + CTAs right
     ══════════════════════════════════════ -->
<section class="cp-intro">
  <div class="cp-intro__inner">
    <div class="cp-intro__left">
      <span class="cp-eyebrow">Service Area</span>
      <h2 class="cp-intro__title">Window film installation across the Wasatch Front.</h2>
    </div>
    <div class="cp-intro__right">
      <p class="cp-intro__lead">Window Film Salt Lake City is the trusted window film contractor across Utah and Utah. With local crews based in the Salt Lake City area, we offer prompt scheduling, on-site estimates, and professional installation across the region. Select your city below to learn more about our services in your area.</p>
      <div class="cp-intro__ctas">
        <a href="/contact/" class="cp-btn cp-btn--primary">Get a Free Quote</a>
        <a href="/applications/" class="cp-btn cp-btn--ghost">Our Applications</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     CITY CARDS — 2-col grid
     ══════════════════════════════════════ -->
<section class="cp-cities">
  <div class="cp-cities__grid">
    {cities.map((c, i) => (
      <a href={c.href} class="cp-city-card fade-in" style={`transition-delay: ${(i % 2) * 100}ms`}>
        <div class="cp-city-card__img">
          <img src={c.img} alt={c.alt} title={c.alt} loading="lazy" />
          <span class="cp-city-card__badge">{c.state}</span>
        </div>
        <div class="cp-city-card__body">
          <h3 class="cp-city-card__title">{c.label}</h3>
          <div class="cp-city-card__rule"></div>
          <p class="cp-city-card__desc">{c.desc}</p>
          <span class="cp-city-card__cta">
            Explore {c.label}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/></svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ══════════════════════════════════════
     COVERAGE MAP — interactive pin map
     ══════════════════════════════════════ -->
<CoveragePinMap
  title="Don't see your city?"
  subtitle="We travel throughout the Salt Lake City metropolitan area and regularly serve communities across Salt Lake Valley, Salt Lake County, and Summit County. Contact us to discuss your project."
/>

<!-- ══════════════════════════════════════
     BRAND LOGOS
     ══════════════════════════════════════ -->
<BrandLogos />

</div><!-- end ip-page-body -->

<!-- ══════════════════════════════════════
     CTA — AVATARS (full-width, outside ip-page-body)
     ══════════════════════════════════════ -->
<CTAAvatars
  title="Ready to get started in your city?"
  subtitle="Free consultation, transparent pricing, and manufacturer-backed warranties on every install."
  count="Trusted by homeowners & businesses across the Wasatch Front"
  btnLabel="Get a Free Quote"
  btnHref="/contact/"
/>

</BaseLayout>

<style>
/* ── PAGE BODY WRAPPER ── */
.ip-page-body {
  position: relative;
  background: #ffffff;
  margin-top: -40px;
  z-index: 10;
  overflow: visible;
  padding-bottom: 80px;
}

/* ── EYEBROW ── */
.cp-eyebrow {
  display: inline-block;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green, #81AB4C);
  margin-bottom: 16px;
}

/* ── BUTTONS ── */
.cp-btn {
  display: inline-block; padding: 14px 28px;
  border-radius: var(--radius-pill, 100px);
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px; font-weight: 500;
  text-decoration: none; transition: all 0.2s;
  border: 2px solid transparent; white-space: nowrap;
}
.cp-btn--primary { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.cp-btn--primary:hover { background: #6e9640; border-color: #6e9640; transform: translateY(-2px); color: #fff; }
.cp-btn--ghost { background: transparent; color: var(--brand, #272E32); border-color: var(--brand, #272E32); }
.cp-btn--ghost:hover { background: var(--brand, #272E32); color: #fff; transform: translateY(-2px); }
.cp-btn--white { background: #fff; color: var(--brand, #272E32); border-color: #fff; font-weight: 600; }
.cp-btn--white:hover { background: var(--off-white, #F7F6F3); transform: translateY(-2px); }
.cp-btn--green { background: var(--green, #81AB4C); color: #fff; border-color: var(--green, #81AB4C); }
.cp-btn--green:hover { background: #6e9640; transform: translateY(-2px); color: #fff; }

/* ── INTRO ── */
.cp-intro {
  padding: 80px 10%;
  border-top-left-radius: 40px;
  border-top-right-radius: 40px;
  overflow: hidden;
}
.cp-intro__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.cp-intro__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(36px, 4.5vw, 58px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1px;
  color: var(--text-dark, #1a1a1a);
  margin: 0;
}
.cp-intro__lead {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 17px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin-bottom: 32px;
}
.cp-intro__ctas { display: flex; gap: 14px; flex-wrap: wrap; }

/* ── CITY CARDS ── */
.cp-cities {
  padding: 0 10% 100px;
}
.cp-cities__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
.cp-city-card {
  background: transparent;
  border-radius: 24px;
  overflow: visible;
  text-decoration: none;
  display: block;
  position: relative;
  border: 1px solid #DDDCDA;
  transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
}
.cp-city-card:hover {
  border-color: var(--green, #81AB4C);
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(0,0,0,0.1);
}
.cp-city-card__img {
  margin: 12px;
  border-radius: 14px;
  overflow: hidden;
  height: 300px;
  position: relative;
}
.cp-city-card__img img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.4s ease;
}
.cp-city-card:hover .cp-city-card__img img {
  transform: scale(1.04);
}
.cp-city-card__badge {
  position: absolute;
  top: 16px;
  right: 16px;
  background: var(--brand, #272E32);
  color: #fff;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 100px;
}
.cp-city-card__body {
  padding: 12px 24px 28px;
}
.cp-city-card__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(24px, 2.5vw, 32px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.2;
  margin-bottom: 14px;
}
.cp-city-card__rule {
  width: 100%; height: 1px;
  background: var(--light-gray, #EFEFED);
  margin-bottom: 16px;
}
.cp-city-card__desc {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 15px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.7;
  margin: 0 0 20px;
}
.cp-city-card__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 14px;
  font-weight: 600;
  color: var(--green, #81AB4C);
  transition: gap 0.2s;
}
.cp-city-card:hover .cp-city-card__cta { gap: 13px; }

/* ── ALSO SERVING ── */
.cp-also {
  background: var(--off-white, #F7F6F3);
  margin: 0 5%;
  border-radius: 32px;
  padding: 64px 60px;
  margin-bottom: 80px;
}
.cp-also__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: start;
}
.cp-also__title {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  color: var(--text-dark, #1a1a1a);
  line-height: 1.2;
  margin: 0 0 16px;
  letter-spacing: -0.5px;
}
.cp-also__body {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 16px;
  color: var(--text-mid, #4a4a4a);
  line-height: 1.75;
  margin: 0 0 28px;
}
.cp-also__also-label {
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--text-light, #888);
  margin: 0 0 16px;
}
.cp-also__pills {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.cp-also__pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 18px;
  background: #fff;
  border: 1px solid var(--light-gray, #EFEFED);
  border-radius: 100px;
  font-family: var(--font-body, 'DM Sans', sans-serif);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-mid, #4a4a4a);
  text-decoration: none;
  transition: border-color 0.2s, color 0.2s;
}
.cp-also__pill svg { color: var(--green, #81AB4C); flex-shrink: 0; }
.cp-also__pill:hover { border-color: var(--green, #81AB4C); color: var(--green, #81AB4C); }

/* ── CTA BANNER ── */
.cp-cta {
  background: var(--brand, #272E32);
  border-radius: 40px;
  padding: 64px 60px;
  display: flex; align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin: 0 5% 0;
}
.cp-cta h2 {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 32px; font-weight: 700;
  color: #fff; line-height: 1.2;
  max-width: 460px; margin: 0;
}
.cp-cta h2 em { font-style: italic; color: var(--green, #81AB4C); }
.cp-cta__btns { display: flex; gap: 14px; flex-shrink: 0; }

/* ── FADE IN ── */
.fade-in { opacity: 0; transform: translateY(24px); transition: opacity 0.65s ease, transform 0.65s ease; }
.fade-in.visible { opacity: 1; transform: translateY(0); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .cp-intro__inner { grid-template-columns: 1fr; gap: 40px; }
  .cp-also__inner { grid-template-columns: 1fr; gap: 40px; }
  .cp-also { padding: 48px 40px; }
}
@media (max-width: 768px) {
  .cp-intro { padding: 60px 5%; }
  .cp-cities { padding: 0 5% 60px; }
  .cp-cities__grid { grid-template-columns: 1fr; }
  .cp-city-card__img { height: 240px; }
  .cp-also { margin: 0 5%; padding: 40px 28px; margin-bottom: 60px; }
  .cp-cta { flex-direction: column; padding: 40px 28px; text-align: center; }
  .cp-cta h2 { font-size: 26px; max-width: 100%; }
  .cp-cta__btns { flex-direction: column; width: 100%; }
}
@media (max-width: 480px) {
  .cp-intro__ctas { flex-direction: column; }
}
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
</script>
